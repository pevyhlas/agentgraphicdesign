# Build outputs
bin/
obj/
out/
publish/
/artifacts/

# IDE
.vs/
.idea/
*.user
*.suo
*.sln.docstates
.vscode/

# OS
.DS_Store
Thumbs.db

# Environment and secrets
.env
.env.*
!.env.example
*.local.json

# Test results
TestResults/
*.trx
coverage/
*.coverage

# NuGet
*.nupkg
*.snupkg
packages/

# Logs
*.log
logs/

# Temporary files
*.tmp
*.temp
*.bak
~*

# AGD runtime markers, not document sources or dependency lockfiles
.agd-store.lock
*.agd.json.lock
.prdkit/ledger/
.worktrees/

# Raw evidence never lives in specs/ (public repository): logs, review packages and traces
# stay in CI, the pull request or the ignored .prdkit/cache/evidence/
specs/**/results/
specs/**/reviews/**/round-*/
specs/**/traces/
*.patch
.prdkit/cache/
.prdkit/retrospective/
