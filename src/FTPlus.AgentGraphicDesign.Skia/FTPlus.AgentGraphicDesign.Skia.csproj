<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <RootNamespace>FTPlus.AgentGraphicDesign.Skia</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="SkiaSharp" />
    <PackageReference Include="SkiaSharp.HarfBuzz" />
    <PackageReference Include="HarfBuzzSharp.NativeAssets.Linux" />
    <PackageReference Include="SkiaSharp.NativeAssets.Linux.NoDependencies" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\FTPlus.AgentGraphicDesign.Core\FTPlus.AgentGraphicDesign.Core.csproj" />
  </ItemGroup>

  <!--
    Bundled default text family: Inter (SIL Open Font License 1.1), static Regular and
    Bold faces from the rsms/inter v4.1 release. Provenance (release tag, SHA-256) is
    recorded in .config/dependencies.json; the licence text is in THIRD-PARTY-NOTICES.txt.
  -->
  <ItemGroup>
    <EmbeddedResource Include="Fonts\Inter-Regular.ttf" LogicalName="FTPlus.AgentGraphicDesign.Skia.Fonts.Inter-Regular.ttf" />
    <EmbeddedResource Include="Fonts\Inter-Bold.ttf" LogicalName="FTPlus.AgentGraphicDesign.Skia.Fonts.Inter-Bold.ttf" />
  </ItemGroup>

</Project>
