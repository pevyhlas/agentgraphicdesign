<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <RootNamespace>FTPlus.AgentGraphicDesign.Core</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Clipper2" />
  </ItemGroup>

  <ItemGroup>
    <!-- Grants must match the consumers' real assembly names, not their project names:
         the CLI ships as "agd" and the MCP server as "agd-mcp" (see their AssemblyName). -->
    <InternalsVisibleTo Include="agd" />
    <InternalsVisibleTo Include="agd-mcp" />
    <InternalsVisibleTo Include="FTPlus.AgentGraphicDesign.Core.Tests" />
    <InternalsVisibleTo Include="FTPlus.AgentGraphicDesign.Skia" />
  </ItemGroup>

</Project>
