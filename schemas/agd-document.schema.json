{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/pevyhlas/agentgraphicdesign/v0.1.0/schemas/agd-document.schema.json",
  "title": "AGD Document",
  "description": "Agent Graphic Design document format (version 1)",
  "type": "object",
  "required": ["version", "id", "name", "revn", "canvas", "root"],
  "properties": {
    "$schema": {
      "type": "string",
      "description": "JSON Schema reference"
    },
    "version": {
      "type": "integer",
      "minimum": 1,
      "description": "Document format version (currently 1)"
    },
    "id": {
      "type": "string",
      "format": "uuid",
      "description": "Unique document identifier"
    },
    "name": {
      "type": "string",
      "minLength": 1,
      "description": "Document name"
    },
    "revn": {
      "type": "integer",
      "minimum": 1,
      "description": "Document revision number (incremented by document mutations)"
    },
    "canvas": {
      "$ref": "#/$defs/canvas"
    },
    "root": {
      "$ref": "#/$defs/frameNode"
    },
    "tokens": {
      "$ref": "#/$defs/designTokens"
    }
  },
  "additionalProperties": true,
  "$defs": {
    "colorLiteral": {
      "type": "string",
      "maxLength": 64,
      "pattern": "^(?:#(?:[0-9a-fA-F]{3}|[0-9a-fA-F]{4}|[0-9a-fA-F]{6}|[0-9a-fA-F]{8})|[rR][gG][bB]\\(\\s*0*(?:[0-9]|[1-9][0-9]|1[0-9]{2}|2[0-4][0-9]|25[0-5])\\s*,\\s*0*(?:[0-9]|[1-9][0-9]|1[0-9]{2}|2[0-4][0-9]|25[0-5])\\s*,\\s*0*(?:[0-9]|[1-9][0-9]|1[0-9]{2}|2[0-4][0-9]|25[0-5])\\s*\\)|[rR][gG][bB][aA]\\(\\s*0*(?:[0-9]|[1-9][0-9]|1[0-9]{2}|2[0-4][0-9]|25[0-5])\\s*,\\s*0*(?:[0-9]|[1-9][0-9]|1[0-9]{2}|2[0-4][0-9]|25[0-5])\\s*,\\s*0*(?:[0-9]|[1-9][0-9]|1[0-9]{2}|2[0-4][0-9]|25[0-5])\\s*,\\s*(?:0+|0*1|0+\\.[0-9]*|0*\\.[0-9]+|0*1\\.0*)\\s*\\))$"
    },
    "tokenName": {
      "type": "string",
      "maxLength": 512,
      "pattern": "^[a-zA-Z0-9_.-]+$"
    },
    "tokenAlias": {
      "type": "string",
      "maxLength": 514,
      "pattern": "^\\{[a-zA-Z0-9_.-]+\\}$"
    },
    "tokenReference": {
      "oneOf": [
        { "$ref": "#/$defs/tokenName" },
        { "$ref": "#/$defs/tokenAlias" }
      ]
    },
    "colorTokenValue": {
      "oneOf": [
        { "$ref": "#/$defs/colorLiteral" },
        { "$ref": "#/$defs/tokenName" },
        { "$ref": "#/$defs/tokenAlias" }
      ]
    },
    "canvas": {
      "type": "object",
      "required": ["width", "height"],
      "properties": {
        "width": {
          "type": "number",
          "exclusiveMinimum": 0,
          "description": "Canvas width in pixels"
        },
        "height": {
          "type": "number",
          "exclusiveMinimum": 0,
          "description": "Canvas height in pixels"
        },
        "background": {
          "$ref": "#/$defs/colorLiteral",
          "description": "Background color as a strict hex, rgb(), or rgba() literal"
        }
      },
      "additionalProperties": true
    },
    "designTokens": {
      "type": "object",
      "properties": {
        "colors": {
          "type": "object",
          "maxProperties": 50000,
          "propertyNames": { "$ref": "#/$defs/tokenName" },
          "additionalProperties": {
            "$ref": "#/$defs/colorTokenValue"
          },
          "description": "Named color tokens containing a strict color literal, bare token name, or braced token alias"
        },
        "typography": {
          "type": "object",
          "maxProperties": 50000,
          "propertyNames": { "$ref": "#/$defs/tokenName" },
          "additionalProperties": {
            "$ref": "#/$defs/typographyToken"
          },
          "description": "Named typography tokens"
        }
      },
      "additionalProperties": true
    },
    "typographyToken": {
      "type": "object",
      "properties": {
        "fontFamily": { "type": "string", "maxLength": 1024, "pattern": ".*\\S.*" },
        "fontSize": { "type": "number", "exclusiveMinimum": 0 },
        "fontWeight": { "type": "integer", "minimum": 100, "maximum": 900 },
        "lineHeight": { "type": "number", "minimum": 0 }
      },
      "additionalProperties": true
    },
    "node": {
      "type": "object",
      "required": ["type", "id"],
      "discriminator": {
        "propertyName": "type"
      },
      "oneOf": [
        { "$ref": "#/$defs/frameNode" },
        { "$ref": "#/$defs/groupNode" },
        { "$ref": "#/$defs/rectangleNode" },
        { "$ref": "#/$defs/ellipseNode" },
        { "$ref": "#/$defs/pathNode" },
        { "$ref": "#/$defs/textNode" },
        { "$ref": "#/$defs/lineNode" },
        { "$ref": "#/$defs/polygonNode" },
        { "$ref": "#/$defs/imageNode" },
        { "$ref": "#/$defs/unknownNode" }
      ]
    },
    "nodeBase": {
      "type": "object",
      "required": ["type", "id"],
      "properties": {
        "type": {
          "type": "string",
          "description": "Node type discriminator"
        },
        "id": {
          "type": "string",
          "format": "uuid",
          "description": "Unique node identifier"
        },
        "order": {
          "type": "string",
          "pattern": "^[0-9A-Za-z]+$",
          "description": "Fractional index for sibling ordering (base-62)"
        },
        "name": {
          "type": "string",
          "description": "Optional node name"
        },
        "visible": {
          "type": "boolean",
          "default": true,
          "description": "Node visibility"
        },
        "locked": {
          "type": "boolean",
          "default": false,
          "description": "Node lock state"
        },
        "transform": {
          "$ref": "#/$defs/transform"
        },
        "style": {
          "$ref": "#/$defs/style"
        }
      },
      "additionalProperties": true
    },
    "transform": {
      "type": "object",
      "properties": {
        "x": { "type": "number", "default": 0, "description": "X translation" },
        "y": { "type": "number", "default": 0, "description": "Y translation" },
        "rotation": { "type": "number", "default": 0, "description": "Rotation in degrees" },
        "scaleX": { "type": "number", "default": 1, "description": "X scale factor" },
        "scaleY": { "type": "number", "default": 1, "description": "Y scale factor" }
      },
      "additionalProperties": true
    },
    "style": {
      "type": "object",
      "properties": {
        "fill": { "$ref": "#/$defs/fill" },
        "stroke": { "$ref": "#/$defs/stroke" },
        "opacity": {
          "type": "number",
          "minimum": 0,
          "maximum": 1,
          "default": 1,
          "description": "Node opacity (0-1)"
        },
        "blendMode": {
          "type": "string",
          "description": "Blend mode"
        },
        "fillRule": {
          "type": "string",
          "enum": ["nonzero", "evenodd"],
          "description": "Fill rule for path and polygon nodes (default: nonzero)"
        }
      },
      "additionalProperties": true
    },
    "fill": {
      "type": "object",
      "properties": {
        "color": {
          "$ref": "#/$defs/colorLiteral",
          "description": "Fill color as a strict hex, rgb(), or rgba() literal"
        },
        "tokenRef": {
          "$ref": "#/$defs/tokenReference",
          "description": "Reference to a color token"
        },
        "gradient": {
          "$ref": "#/$defs/gradient"
        }
      },
      "additionalProperties": true
    },
    "gradient": {
      "type": "object",
      "oneOf": [
        { "$ref": "#/$defs/linearGradient" },
        { "$ref": "#/$defs/radialGradient" }
      ]
    },
    "gradientBase": {
      "type": "object",
      "required": ["type"],
      "properties": {
        "type": { "type": "string" },
        "stops": {
          "type": "array",
          "items": { "$ref": "#/$defs/gradientStop" }
        }
      },
      "additionalProperties": true
    },
    "linearGradient": {
      "allOf": [
        { "$ref": "#/$defs/gradientBase" },
        {
          "type": "object",
          "required": ["type"],
          "properties": {
            "type": { "const": "linear" },
            "x1": { "type": "number" },
            "y1": { "type": "number" },
            "x2": { "type": "number" },
            "y2": { "type": "number" }
          }
        }
      ]
    },
    "radialGradient": {
      "allOf": [
        { "$ref": "#/$defs/gradientBase" },
        {
          "type": "object",
          "required": ["type"],
          "properties": {
            "type": { "const": "radial" },
            "cx": { "type": "number" },
            "cy": { "type": "number" },
            "r": { "type": "number", "minimum": 0 },
            "fx": { "type": "number" },
            "fy": { "type": "number" }
          }
        }
      ]
    },
    "gradientStop": {
      "type": "object",
      "required": ["offset", "color"],
      "properties": {
        "offset": { "type": "number", "minimum": 0, "maximum": 1 },
        "color": { "$ref": "#/$defs/colorLiteral" },
        "opacity": { "type": "number", "minimum": 0, "maximum": 1 }
      },
      "additionalProperties": true
    },
    "stroke": {
      "type": "object",
      "properties": {
        "color": {
          "$ref": "#/$defs/colorLiteral",
          "description": "Stroke color as a strict hex, rgb(), or rgba() literal"
        },
        "tokenRef": {
          "$ref": "#/$defs/tokenReference",
          "description": "Reference to a color token"
        },
        "width": {
          "type": "number",
          "minimum": 0,
          "default": 1,
          "description": "Stroke width in pixels"
        },
        "cap": {
          "type": "string",
          "enum": ["butt", "round", "square"],
          "default": "butt"
        },
        "join": {
          "type": "string",
          "enum": ["miter", "round", "bevel"],
          "default": "miter"
        },
        "miterLimit": {
          "type": "number",
          "minimum": 0,
          "default": 4
        },
        "dashArray": {
          "type": "array",
          "items": { "type": "number", "minimum": 0 }
        },
        "dashOffset": {
          "type": "number",
          "default": 0
        }
      },
      "additionalProperties": true
    },
    "frameNode": {
      "allOf": [
        { "$ref": "#/$defs/nodeBase" },
        {
          "type": "object",
          "properties": {
            "type": { "const": "frame" },
            "width": {
              "type": "number",
              "minimum": 0,
              "description": "Frame width"
            },
            "height": {
              "type": "number",
              "minimum": 0,
              "description": "Frame height"
            },
            "clipContent": {
              "type": "boolean",
              "default": true,
              "description": "Whether to clip child content to frame bounds"
            },
            "children": {
              "type": "array",
              "items": { "$ref": "#/$defs/node" },
              "description": "Child nodes"
            }
          },
          "required": ["type", "children"]
        }
      ]
    },
    "groupNode": {
      "allOf": [
        { "$ref": "#/$defs/nodeBase" },
        {
          "type": "object",
          "properties": {
            "type": { "const": "group" },
            "children": {
              "type": "array",
              "items": { "$ref": "#/$defs/node" },
              "description": "Child nodes"
            }
          },
          "required": ["type", "children"]
        }
      ]
    },
    "rectangleNode": {
      "allOf": [
        { "$ref": "#/$defs/nodeBase" },
        {
          "type": "object",
          "properties": {
            "type": { "const": "rectangle" },
            "width": {
              "type": "number",
              "minimum": 0,
              "description": "Rectangle width"
            },
            "height": {
              "type": "number",
              "minimum": 0,
              "description": "Rectangle height"
            },
            "cornerRadius": {
              "type": "number",
              "minimum": 0,
              "default": 0,
              "description": "Corner radius for rounded rectangles"
            }
          },
          "required": ["type"]
        }
      ]
    },
    "ellipseNode": {
      "allOf": [
        { "$ref": "#/$defs/nodeBase" },
        {
          "type": "object",
          "properties": {
            "type": { "const": "ellipse" },
            "width": {
              "type": "number",
              "minimum": 0,
              "description": "Ellipse width (horizontal diameter)"
            },
            "height": {
              "type": "number",
              "minimum": 0,
              "description": "Ellipse height (vertical diameter)"
            }
          },
          "required": ["type"]
        }
      ]
    },
    "pathNode": {
      "allOf": [
        { "$ref": "#/$defs/nodeBase" },
        {
          "type": "object",
          "properties": {
            "type": { "const": "path" },
            "d": {
              "type": "string",
              "description": "SVG path data (d attribute)"
            }
          },
          "required": ["type"]
        }
      ]
    },
    "textNode": {
      "allOf": [
        { "$ref": "#/$defs/nodeBase" },
        {
          "type": "object",
          "properties": {
            "type": { "const": "text" },
            "text": {
              "type": "string",
              "description": "Text content"
            },
            "fontFamily": {
              "type": "string",
              "description": "Font family name"
            },
            "fontSize": {
              "type": "number",
              "exclusiveMinimum": 0,
              "default": 16,
              "description": "Font size in pixels"
            },
            "fontWeight": {
              "type": "integer",
              "minimum": 100,
              "maximum": 900,
              "default": 400,
              "description": "Font weight (100-900)"
            },
            "typographyTokenRef": {
              "$ref": "#/$defs/tokenReference",
              "description": "Reference to a typography token"
            },
            "textAlign": {
              "type": "string",
              "enum": ["start", "center", "end"],
              "default": "start",
              "description": "Horizontal alignment of each line relative to the node's x"
            },
            "verticalAlign": {
              "type": "string",
              "enum": ["top", "middle", "bottom", "baseline"],
              "default": "top",
              "description": "Which edge of the text block sits at the node's y; top keeps the first baseline one font size below y"
            },
            "maxWidth": {
              "type": "number",
              "exclusiveMinimum": 0,
              "description": "Wrap width in pixels; omitted means no wrapping"
            },
            "lineHeight": {
              "type": "number",
              "exclusiveMinimum": 0,
              "description": "Line pitch as a multiple of the font size; node, then typography token, then 1.2"
            },
            "letterSpacing": {
              "type": "number",
              "default": 0,
              "description": "Extra advance after each glyph in pixels"
            }
          },
          "required": ["type"]
        }
      ]
    },
    "lineNode": {
      "allOf": [
        { "$ref": "#/$defs/nodeBase" },
        {
          "type": "object",
          "properties": {
            "type": { "const": "line" },
            "x1": { "type": "number" },
            "y1": { "type": "number" },
            "x2": { "type": "number" },
            "y2": { "type": "number" }
          },
          "required": ["type"]
        }
      ]
    },
    "polygonNode": {
      "allOf": [
        { "$ref": "#/$defs/nodeBase" },
        {
          "type": "object",
          "properties": {
            "type": { "const": "polygon" },
            "points": {
              "type": "array",
              "items": { "$ref": "#/$defs/point" }
            },
            "closed": { "type": "boolean", "default": true }
          },
          "required": ["type"]
        }
      ]
    },
    "point": {
      "type": "object",
      "required": ["x", "y"],
      "properties": {
        "x": { "type": "number" },
        "y": { "type": "number" }
      },
      "additionalProperties": true
    },
    "imageNode": {
      "allOf": [
        { "$ref": "#/$defs/nodeBase" },
        {
          "type": "object",
          "properties": {
            "type": { "const": "image" },
            "src": {
              "type": "string",
              "description": "Source URL, path, or bounded embedded data URI; raster rendering never fetches paths or URLs"
            },
            "width": { "type": "number", "minimum": 0 },
            "height": { "type": "number", "minimum": 0 }
          },
          "required": ["type"]
        }
      ]
    },
    "unknownNode": {
      "allOf": [
        { "$ref": "#/$defs/nodeBase" },
        {
          "type": "object",
          "properties": {
            "type": { "const": "unknown" },
            "originalType": {
              "type": "string",
              "description": "Original type before fallback to unknown"
            }
          },
          "required": ["type"]
        }
      ]
    }
  }
}
