{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:agd:provided-artifact:1",
  "title": "AGD Provided Artifact Metadata v1",
  "description": "Structural and value constraints for unverified provided PNG still or clip metadata. This does not verify payloads or admit artifacts.",
  "$comment": "Not parser parity: duplicate keys, raw token spelling/size, integer lexical syntax, pivot lexical precision, Unicode/input/canonical byte limits, inventory uniqueness/references, path device stems/prefix conflicts, and aggregate area/bytes/pixel work/duration checks require the metadata parser. JSON Schema integers are mathematical integers; multipleOf constrains pivot values, not their spelling.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "version", "profile", "assetId", "canvas", "cropOrigin", "files"],
  "properties": {
    "schema": { "type": "string", "const": "agd.provided-artifact" },
    "version": { "type": "integer", "const": 1 },
    "profile": { "type": "string", "const": "png8-rgba-srgb-straight-fixed-canvas-v1" },
    "assetId": { "$ref": "#/$defs/logicalId" },
    "canvas": { "$ref": "#/$defs/canvas" },
    "cropOrigin": { "$ref": "#/$defs/cropOrigin" },
    "files": {
      "type": "array",
      "minItems": 1,
      "maxItems": 4096,
      "items": { "$ref": "#/$defs/file" }
    },
    "still": { "$ref": "#/$defs/still" },
    "clip": { "$ref": "#/$defs/clip" },
    "provenance": { "$ref": "#/$defs/provenance" }
  },
  "oneOf": [
    {
      "required": ["still"],
      "properties": {
        "clip": false,
        "files": { "maxItems": 1 }
      }
    },
    {
      "required": ["clip"],
      "properties": { "still": false }
    }
  ],
  "$defs": {
    "logicalId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 64,
      "pattern": "^[a-z][a-z0-9_-]{0,63}(?![\\s\\S])"
    },
    "sha256": {
      "type": "string",
      "minLength": 64,
      "maxLength": 64,
      "pattern": "^[0-9a-f]{64}(?![\\s\\S])"
    },
    "path": {
      "type": "string",
      "minLength": 5,
      "maxLength": 240,
      "pattern": "^(?:[a-z0-9](?:[a-z0-9._-]{0,62}[a-z0-9_-])?/){0,7}[a-z0-9][a-z0-9._-]{0,59}\\.png(?![\\s\\S])",
      "description": "Lowercase ASCII relative slash path, at most eight segments of at most 64 characters, no trailing segment dot, and a .png leaf. Device stems and file/directory prefix conflicts require the parser."
    },
    "canvas": {
      "type": "object",
      "additionalProperties": false,
      "required": ["width", "height", "coordinates"],
      "properties": {
        "width": { "type": "integer", "minimum": 1, "maximum": 8192 },
        "height": { "type": "integer", "minimum": 1, "maximum": 8192 },
        "coordinates": { "type": "string", "const": "top-left-pixel-edges-x-right-y-down" }
      }
    },
    "cropOrigin": {
      "type": "object",
      "additionalProperties": false,
      "required": ["x", "y"],
      "properties": {
        "x": { "type": "integer", "const": 0 },
        "y": { "type": "integer", "const": 0 }
      }
    },
    "file": {
      "type": "object",
      "additionalProperties": false,
      "required": ["sha256", "path", "byteLength"],
      "properties": {
        "sha256": { "$ref": "#/$defs/sha256" },
        "path": { "$ref": "#/$defs/path" },
        "byteLength": { "type": "integer", "minimum": 1, "maximum": 67108864 }
      }
    },
    "still": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "fileSha256", "pivot"],
      "properties": {
        "name": { "$ref": "#/$defs/logicalId" },
        "fileSha256": { "$ref": "#/$defs/sha256" },
        "pivot": { "$ref": "#/$defs/pivot" }
      }
    },
    "clip": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "viewId", "variantId", "ticksPerSecond", "playback", "frames"],
      "properties": {
        "id": { "$ref": "#/$defs/logicalId" },
        "viewId": { "$ref": "#/$defs/logicalId" },
        "variantId": { "$ref": "#/$defs/logicalId" },
        "ticksPerSecond": { "type": "integer", "minimum": 1, "maximum": 1000000000 },
        "playback": { "type": "string", "enum": ["forward-loop", "forward-once-hold"] },
        "frames": {
          "type": "array",
          "minItems": 1,
          "maxItems": 4096,
          "items": { "$ref": "#/$defs/frame" }
        }
      }
    },
    "frame": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "fileSha256", "durationTicks", "pivot"],
      "properties": {
        "name": { "$ref": "#/$defs/logicalId" },
        "fileSha256": { "$ref": "#/$defs/sha256" },
        "durationTicks": { "type": "integer", "minimum": 1, "maximum": 9007199254740991 },
        "pivot": { "$ref": "#/$defs/pivot" }
      }
    },
    "pivot": {
      "type": "object",
      "additionalProperties": false,
      "required": ["x", "y"],
      "properties": {
        "x": { "$ref": "#/$defs/pivotCoordinate" },
        "y": { "$ref": "#/$defs/pivotCoordinate" }
      }
    },
    "pivotCoordinate": {
      "type": "number",
      "minimum": -1000000,
      "maximum": 1000000,
      "multipleOf": 0.000001
    },
    "provenance": {
      "type": "object",
      "additionalProperties": false,
      "minProperties": 1,
      "properties": {
        "producer": { "$ref": "#/$defs/producer" },
        "recipeSnapshotSha256": { "$ref": "#/$defs/sha256" }
      }
    },
    "producer": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "version"],
      "properties": {
        "id": { "$ref": "#/$defs/logicalId" },
        "version": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9.+_-]{0,63}(?![\\s\\S])"
        }
      }
    }
  }
}
